# Savage Reply - Environment Variables
# Copy this file to .env and fill in your values

# === LLM Provider ===
# Get a FREE API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Provider: 'groq' (cloud, free) or 'ollama' (local, needs more RAM)
LLM_PROVIDER=groq

# Model name (default: gemma2-9b-it for Groq)
LLM_MODEL=gemma2-9b-it

# === Optional Settings ===
# TTS voice gender: 'male' or 'female'
TTS_VOICE_GENDER=male

# Share the app publicly (for phone access): 'true' or 'false'
GRADIO_SHARE=true
